@LibraryManagement.Api_HostAddress = http://localhost:5221
@BookId = 1
@BookCopyBarcode = BC-PASTE-RETURNED-BARCODE-HERE

GET {{LibraryManagement.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{LibraryManagement.Api_HostAddress}}/api/books?page=1&pageSize=20
Accept: application/json

###

GET {{LibraryManagement.Api_HostAddress}}/api/books?page=2&pageSize=10
Accept: application/json

###

GET {{LibraryManagement.Api_HostAddress}}/api/books?search=history
Accept: application/json

###

GET {{LibraryManagement.Api_HostAddress}}/api/books?search=history&page=1&pageSize=10
Accept: application/json

###

POST {{LibraryManagement.Api_HostAddress}}/api/books
Content-Type: application/json

{
  "isbn": "9780000009999",
  "title": "Laws of the Jungle",
  "author": "Test Author",
  "category": "Fiction",
  "publisher": "Test Publisher",
  "publicationYear": 2023,
  "replacementCost": 19.99,
  "initialCopies": 5
}

###

GET {{LibraryManagement.Api_HostAddress}}/api/books/{{BookId}}/copies
Accept: application/json

###

POST {{LibraryManagement.Api_HostAddress}}/api/books/{{BookId}}/copies

###

PUT {{LibraryManagement.Api_HostAddress}}/api/books/{{BookId}}/copies/{{BookCopyBarcode}}/status
Content-Type: application/json

{
  "status": "Damaged"
}

###

PUT {{LibraryManagement.Api_HostAddress}}/api/books/{{BookId}}/copies/{{BookCopyBarcode}}/status
Content-Type: application/json

{
  "status": "Missing"
}

###

GET {{LibraryManagement.Api_HostAddress}}/api/books

###
